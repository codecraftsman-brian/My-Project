# Flask / App
FLASK_ENV=production
SECRET_KEY=change-this-super-secret-key

# Database (SQLALCHEMY_DATABASE_URI preferred)
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/job_portal

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_password
MAIL_DEFAULT_SENDER=Jobs Portal <your_email@example.com>

# Admin bootstrap on first run (created if not exists)
ADMIN_EMAIL=admin@jobportal.test
ADMIN_PASSWORD=ChangeThisAdminPassword123

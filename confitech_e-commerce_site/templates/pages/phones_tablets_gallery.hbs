{{#*inline "body_content"}}
<script src="/static/Js/products.js"></script>
<!-- Phones & Tablets Section -->
<section class="max-w-7xl mx-auto sm:px-6 lg:px-8 py-4">
    {{!-- Breadcrumb with dynamic data --}}
    {{#each product.phones_tablets.header.path_link}}
    {{>components/breadcrumb/paths}}
    {{/each}}

    <!-- Page Header -->
    {{#each product.phones_tablets.header.page_title}}
    {{>components/product/product_header}}
    {{/each}}
    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
        <!-- Filter Bar -->
        <div class="bg-white rounded-xl shadow-md p-4 mb-8 flex flex-wrap gap-4 items-center justify-between">
            <div class="flex items-center gap-4">
                <span class="text-gray-700 font-semibold">Filter by:</span>
                <select
                    class="border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-600 focus:outline-none">
                    <option>All Categories</option>
                    <option>Smartphones</option>
                    <option>Tablets</option>
                </select>
                <select
                    class="border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-600 focus:outline-none">
                    <option>Price Range</option>
                    <option>Under $500</option>
                    <option>$500 - $1000</option>
                    <option>Over $1000</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-gray-600">Showing 2 products</span>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Product Card 1: iPhone 15 Pro -->
            {{#each product.phones_tablets}}
            {{#with this.product_meta}}
            {{>components/product/product_container}}
            {{/with}}
            {{/each}}
        </div>

        <!-- Pagination -->
        <div class="flex justify-center items-center space-x-2 mt-12">
            <button
                class="pagination-btn w-10 h-10 rounded-full border-2 border-gray-300 flex items-center justify-center hover:border-blue-600 hover:bg-blue-50 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
            </button>
            <button class="pagination-btn active w-10 h-10 rounded-full font-bold">1</button>
            <button
                class="pagination-btn w-10 h-10 rounded-full border-2 border-gray-300 font-bold hover:border-blue-600 hover:bg-blue-50 transition-colors">2</button>
            <button
                class="pagination-btn w-10 h-10 rounded-full border-2 border-gray-300 font-bold hover:border-blue-600 hover:bg-blue-50 transition-colors">3</button>
            <button
                class="pagination-btn w-10 h-10 rounded-full border-2 border-gray-300 font-bold hover:border-blue-600 hover:bg-blue-50 transition-colors">4</button>
            <span class="px-2 text-gray-500">...</span>
            <button
                class="pagination-btn w-10 h-10 rounded-full border-2 border-gray-300 font-bold hover:border-blue-600 hover:bg-blue-50 transition-colors">10</button>
            <button
                class="pagination-btn w-10 h-10 rounded-full border-2 border-gray-300 flex items-center justify-center hover:border-blue-600 hover:bg-blue-50 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>
</section>

<!-- Our Services Section -->     
{{>components/our_services/services}}

<!-- Footer -->
{{>components/footer/footer_section}}

<script>
    // Pagination functionality
    document.querySelectorAll('.pagination-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.pagination-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
        });
    });
</script>
{{/inline}}
{{>layouts/base}}
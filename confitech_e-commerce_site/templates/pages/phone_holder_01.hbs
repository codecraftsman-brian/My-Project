{{#*inline "product_content"}}
<!-- Main Product Section -->
{{#with (lookup product.phones_tablets_accessories "phone_holder_01")}}
{{>components/product_details/product_view}}
{{/with}}
<script>
    const images = [
        "static/images/phone_accessories/phone_holder_01/phone_holder_01.jpg",
        "static/images/phone_accessories/phone_holder_01/phone_holder_02.jpg",
        "static/images/phone_accessories/phone_holder_01/phone_holder_03.jpg",
        "static/images/phone_accessories/phone_holder_01/phone_holder_04.jpg",
    ];

    function changeImage(index) {
        document.getElementById("mainImage").src = images[index];
        document.querySelectorAll('[onclick^="changeImage"]').forEach((thumb, i) => {
            thumb.classList.toggle("thumbnail-active", i === index);
        });
    }
</script>
{{/inline}}
{{>layouts/product_details}}
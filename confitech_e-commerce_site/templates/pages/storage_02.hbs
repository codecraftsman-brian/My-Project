{{#*inline "product_content"}}
<!-- Main Product Section -->
{{#with (lookup product.storage "storage_02")}}
{{>components/product_details/product_view}}
{{/with}}
<script>
    const images = [
        "static/images/smartwatch/smartwatch_02/smartwatch_01.jpg",
        "static/images/smartwatch/smartwatch_02/smartwatch_02.jpg",
        "static/images/smartwatch/smartwatch_02/smartwatch_03.jpg",
        "static/images/smartwatch/smartwatch_02/smartwatch_04.jpg",
    ];

    function changeImage(index) {
        document.getElementById("mainImage").src = images[index];
        document.querySelectorAll('[onclick^="changeImage"]').forEach((thumb, i) => {
            thumb.classList.toggle("thumbnail-active", i === index);
        });
    }
</script>
{{/inline}}
{{>layouts/product_details}}
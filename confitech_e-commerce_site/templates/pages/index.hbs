    </div>
</section>

<!-- TV & Electronics Section with Carousel -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row justify-between items-center">
        <div>
            <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-2">Tv's & Accessories</h2>
        </div>
    </div>
    <div class="flex gap-6 flex-col lg:flex-row mt-6">
        <!-- Main Television Carousel Section -->
        <div class="flex-1 relative">
            <div class="rounded-2xl shadow-2xl h-96 relative overflow-hidden cursor-pointer group">
                <!-- TV Carousel Slides -->
                <!-- Slide 1 -->
                {{#each display_section.middle_section.tv_accessories}}
                {{>components/mid_section/tv_accessories}}
                {{/each}}

                <!-- Navigation Arrows -->
                <button id="tvPrevBtn"
                    class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-white/20 backdrop-blur-sm text-white p-3 rounded-full hover:bg-white/30 transition-all z-10">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7">
                        </path>
                    </svg>
                </button>
                <button id="tvNextBtn"
                    class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-white/20 backdrop-blur-sm text-white p-3 rounded-full hover:bg-white/30 transition-all z-10">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                        </path>
                    </svg>
                </button>

                <!-- Dots Indicator -->
                <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex space-x-3 z-10">
                    <button class="tv-dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition-all"
                        data-slide="1"></button>
                    <button class="tv-dot w-3 h-3 rounded-full bg-white/30 hover:bg-white transition-all"
                        data-slide="2"></button>
                    <button class="tv-dot w-3 h-3 rounded-full bg-white/30 hover:bg-white transition-all"
                        data-slide="3"></button>
                </div>
            </div>
        </div>

        <!-- Right Side Cards -->
        <div class="flex flex-col gap-6 w-full lg:w-80">
            <!-- Audio Card -->
            <div class="bg-cover bg-center rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2 relative overflow-hidden cursor-pointer group h-48 lg:h-44"
                style="background-image: linear-gradient(135deg, rgba(59, 131, 246, 0.1), rgba(147, 51, 234, 0.1)), url('static/images/audio.jpg');">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-600/80 to-purple-700/80"></div>
                <div class="relative h-full flex flex-col justify-between p-6">
                    <div class="flex items-start justify-between">
                        <div
                            class="bg-white/20 backdrop-blur-sm rounded-full p-3 group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15.536a5 5 0 001.414 1.414">
                                </path>
                            </svg>
                        </div>
                    </div>
                    <div class="text-white">
                        <h3 class="font-bold text-xl lg:text-2xl mb-2">Premium Audio</h3>
                        <p class="text-white/90 text-sm mb-3">Wireless headphones, speakers & sound systems</p>
                        <div class="flex items-center justify-between">
                            <span class="text-white font-bold text-lg">From $49</span>
                            <div class="flex items-center text-sm">
                                <span class="mr-2">Shop Now</span>
                                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9 5l7 7-7 7">
                                    </path>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Storage Card -->
            <div class="bg-cover bg-center rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2 relative overflow-hidden cursor-pointer group h-48 lg:h-44"
                style="background-image: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(59, 130, 246, 0.1)), url('static/images/storage.jpg');">
                <div class="absolute inset-0 bg-gradient-to-br from-green-500/80 to-blue-600/80"></div>
                <div class="relative h-full flex flex-col justify-between p-6">
                    <div class="flex items-start justify-between">
                        <div
                            class="bg-white/20 backdrop-blur-sm rounded-full p-3 group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01">
                                </path>
                            </svg>
                        </div>
                    </div>
                    <div class="text-white">
                        <h3 class="font-bold text-xl lg:text-2xl mb-2">Storage</h3>
                        <p class="text-white/90 text-sm mb-3">External drives, SSDs & backup solutions</p>
                        <div class="flex items-center justify-between">
                            <span class="text-white font-bold text-lg">From $29</span>
                            <div class="flex items-center text-sm">
                                <span class="mr-2">Shop Now</span>
                                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9 5l7 7-7 7">
                                    </path>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


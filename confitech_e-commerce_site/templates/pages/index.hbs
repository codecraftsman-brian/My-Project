{{#*inline "body_content"}}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 h-96">
        <!-- Main Hero Image Carousel (spans 3 columns) -->
        <div class="lg:col-span-3 relative overflow-hidden rounded-2xl shadow-2xl">
            <!-- Image Container -->
            <div class="relative h-full">
                <div id="slide1" class="absolute inset-0 h-full w-full slide-in slide-bg"
                    style="background-image: url('static/images/logo.svg');">
                    <!--**-->
                    <div class="gradient-overlay absolute inset-0"></div>
                </div>
                {{#each display_section.hero_section.slides_data}}
                {{>components/hero_section/slide}}
                {{/each}}

            </div>

            <!-- Navigation Arrows -->
            <button id="prevBtn"
                class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-white/20 backdrop-blur-sm text-white p-3 rounded-full hover:bg-white/30 transition-all">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7">
                    </path>
                </svg>
            </button>
            <button id="nextBtn"
                class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-white/20 backdrop-blur-sm text-white p-3 rounded-full hover:bg-white/30 transition-all">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>

            <!-- Dots Indicator -->
            <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex space-x-3">
                <button class="dot w-3 h-3 rounded-full bg-white/50 hover:bg-white transition-all"
                    data-slide="1"></button>
                <button class="dot w-3 h-3 rounded-full bg-white/30 hover:bg-white transition-all"
                    data-slide="2"></button>
                <button class="dot w-3 h-3 rounded-full bg-white/30 hover:bg-white transition-all"
                    data-slide="3"></button>
                <button class="dot w-3 h-3 rounded-full bg-white/30 hover:bg-white transition-all"
                    data-slide="4"></button>
            </div>
        </div>

        <!-- Right Side Cards (3 cards stacked vertically) -->
        <div class="flex flex-col space-y-4 lg:space-y-6">
            {{#each display_section.hero_section.cards_data}}
            {{>components/hero_section/hero_card_right}}
            {{/each}}
        </div>
    </div>

    <!-- Bottom Cards (3 cards in a row) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <!-- Bottom Card 1 -->
        {{#each display_section.hero_section.bottom_cards}}
        {{>components/hero_section/bottom_card}}
        {{/each}}

    </div>
</section>

<!-- Fresh Arrivals Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            Fresh <span
                class="bg-gradient-to-r from-green-600 to-blue-600 bg-clip-text text-transparent">Arrivals</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Discover the latest tech products that just landed in our store - from cutting-edge smartphones to
            innovative accessories
        </p>
    </div>

    <!-- Product Slider Container -->
    <div class="relative bg-gradient-to-r from-gray-50 via-white to-gray-50 rounded-2xl shadow-lg overflow-hidden p-8">
        <div class="relative overflow-hidden">
            <div class="flex product-slider space-x-8">
                <!-- First set of products -->
                {{#each products.fresh_arrivals}}
                {{>components/fresh_arrivals/fresh_arrival}}
                {{/each}}
            </div>
        </div>

        <!-- Navigation hint -->
        <div class="flex justify-center mt-8">
            <div class="flex items-center space-x-2 text-gray-500 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Hover to pause • Latest products updated daily</span>
            </div>
        </div>
    </div>

    <!-- Product Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
        {{#each stats.services_stat}}
        {{>components/fresh_arrivals/product_stats}}
        {{/each}}
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flash-gradient rounded-2xl shadow-2xl overflow-hidden">
        <div class="bg-black/20 p-6">
            <!-- Flash Sale Header -->
            <div class="flex flex-col md:flex-row justify-between items-center mb-8 space-y-4 md:space-y-0">
                <!-- Title and Live Alert -->
                <div class="flex items-center space-x-4">
                    <h2 class="text-4xl md:text-5xl font-bold text-white">
                        ⚡ Flash Sale
                    </h2>
                    <div class="flex items-center space-x-2 bg-red-600 px-4 py-2 rounded-full live-pulse">
                        <div class="w-3 h-3 bg-white rounded-full bounce-animation"></div>
                        <span class="text-white font-bold text-sm uppercase tracking-wide">Live Now</span>
                    </div>
                </div>

                <!-- Countdown Timer -->
                <div class="flex items-center space-x-4">
                    <div class="text-white text-center">
                        <div class="text-sm font-medium mb-1">Ends In</div>
                        <div class="flex space-x-2">
                            <div class="bg-white/20 backdrop-blur-sm rounded-lg p-2 min-w-[3rem]">
                                <div id="hours" class="text-2xl font-bold text-white">12</div>
                                <div class="text-xs text-white/80">HRS</div>
                            </div>
                            <div class="text-2xl text-white self-center">:</div>
                            <div class="bg-white/20 backdrop-blur-sm rounded-lg p-2 min-w-[3rem]">
                                <div id="minutes" class="text-2xl font-bold text-white">34</div>
                                <div class="text-xs text-white/80">MIN</div>
                            </div>
                            <div class="text-2xl text-white self-center">:</div>
                            <div class="bg-white/20 backdrop-blur-sm rounded-lg p-2 min-w-[3rem]">
                                <div id="seconds" class="text-2xl font-bold text-white">56</div>
                                <div class="text-xs text-white/80">SEC</div>
                            </div>
                        </div>
                    </div>

                    <!-- CTA Button -->
                    <button
                        class="bg-white text-gray-900 px-8 py-3 rounded-full font-bold text-lg hover:bg-gray-100 transform hover:scale-105 transition-all shadow-lg hover:shadow-xl">
                        🔥 View All Deals
                    </button>
                </div>
            </div>

            <!-- Flash Sale Products -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                {{#each products.flash_sales}}
                {{>components/flash_sales/flash_sale}}
                {{/each}}

            </div>
        </div>
    </div>
</section>

<!-- Top Brands Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">

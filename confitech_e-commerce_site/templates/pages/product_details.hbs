{{#*inline "body_content"}}

<!-- Breadcrumb -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <nav class="flex text-sm text-gray-600 gap-2">
        <a href="/index" class="hover:text-blue-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/tablets" class="hover:text-blue-600">Phones & Tablets</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium">Samsung Galaxy S24 Ultra</span>
    </nav>
</div>

<!-- Main Product Section -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Images -->
        <div class="space-y-4">
            {{#each product_details/product_detail.display_image}}
            {{>components/product_details/main_image}}
            {{/each}}
            <div class="grid grid-cols-4 gap-4">
                {{#each product_details/product_detail.thumbnail_images}}
                {{>components/product_details/thumbnail_images}}
                {{/each}}
            </div>

            <!-- Features -->
            <div class="bg-blue-50 rounded-xl p-6">
                <h3 class="text-lg font-semibold mb-4">Key Features</h3>
                <ul class="space-y-2">
                    {{#each product_details/product_detail.key_features}}
                    {{>components/product_details/key_features}}
                    {{/each}}
                </ul>
            </div>
        </div>

        <!-- Details -->
        <div class="space-y-6">
            <div>
                {{#each product_details/product_detail.product_title}}
                {{>components/product_details/product_title}}
                {{/each}}
            </div>

            <!-- Storage & Color-->
            <div>
                {{>components/product_details/product_specificies}}
            </div>

            <!-- Quantity -->
            <div>
                <h3 class="text-lg font-semibold mb-3">Quantity</h3>
                <div class="inline-flex border-2 border-gray-300 rounded-lg">
                    <button onclick="decreaseQuantity()" class="px-4 py-2 hover:bg-gray-100">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                        </svg>
                    </button>
                    <input id="quantityInput" type="text" value="1" readonly
                        class="w-16 text-center font-semibold text-lg border-x-2 border-gray-300 py-2">
                    <button onclick="increaseQuantity()" class="px-4 py-2 hover:bg-gray-100">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4">
                            </path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Buttons -->
            <div class="grid grid-cols-2 gap-4">
                <button
                    class="bg-white border-2 border-gray-300 py-4 rounded-xl font-bold text-lg hover:border-gray-400">Add
                    to Cart</button>
                <button class="bg-blue-600 text-white py-4 rounded-xl font-bold text-lg hover:bg-blue-700 shadow-lg">Buy
                    it Now</button>
            </div>
            <button
                class="w-full bg-white border-2 border-gray-300 py-3 rounded-xl font-semibold hover:border-gray-400 flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                    </path>
                </svg>
                Add to Wishlist
            </button>

            <!-- Delivery -->
            <div class="bg-gray-100 rounded-xl p-6">
                <h3 class="text-lg font-semibold mb-3">Delivery Location</h3>
                <p class="text-sm text-gray-600 mb-4">Enter pincode to check availability</p>
                <div class="flex gap-3">
                    <input type="text" placeholder="Enter pincode"
                        class="flex-1 px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-600 focus:outline-none">
                    <button
                        class="bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700">Apply</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Accordion -->
    <div class="mt-16 bg-white rounded-2xl shadow-lg p-8">
        <h2 class="text-2xl font-bold mb-6">Product Information</h2>

        {{>components/product_details/product_description}}

        {{>components/product_details/return_policy}}
    </div>

    <!-- Reviews -->
    <div class="mt-16 bg-white rounded-2xl shadow-lg p-8">
        <h2 class="text-2xl font-bold mb-6">Customer Reviews</h2>

        {{>components/product_details/review_title}}

        <div class="space-y-6">
            {{#each product_details.storage.reviews_body}}
            {{>components/product_details/review_body}}
            {{/each}}

        </div>
        <button class="mt-6 text-blue-600 font-semibold hover:text-blue-700">Read all reviews</button>
    </div>
</div>

<!-- Footer -->
<footer class="bg-gray-900 text-white mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
            <!-- Company Info -->
            {{>components/footer/company_logo}}

            <!-- Our Company -->
            <div>
                <h4 class="text-lg font-bold mb-4">Our Company</h4>
                {{#each footer.footer_info.our_company}}
                {{>components/footer/our_company}}
                {{/each}}
            </div>

            <!-- Services -->
            <div>
                <h4 class="text-lg font-bold mb-4">Services</h4>
                {{>components/footer/services}}
            </div>

            <!-- Follow Us -->
            <div>
                <h4 class="text-lg font-bold mb-4">Follow Us</h4>

                <div class="flex space-x-3 mb-8">
                    {{#each footer.footer_info.social_media}}
                    {{>components/footer/social_media}}
                    {{/each}}
                </div>
                <div class="space-y-2">
                    <p class="text-sm"><span class="font-semibold">Shop Location:</span></p>
                    <p class="text-gray-400 text-sm">123 Tech Avenue, Nairobi</p>
                    <p class="text-sm"><span class="font-semibold">Email:</span></p>
                    <p class="text-gray-400 text-sm">support@techstore.com</p>
                </div>
            </div>

            <!-- Contact Us -->
            <div>
                {{>components/footer/contact_us}}

            </div>
        </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <p class="text-center text-gray-400 text-sm">
                © 2025 Tech Store Ltd. All Rights Reserved. | Designed with
                <span class="text-red-500">❤</span> by Your Team
            </p>
        </div>
    </div>
</footer>

<script src="/static/js/p_details.js"></script>

{{/inline}}
{{>layouts/base}}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Images -->
        {{>components/product_details/thumbnail_images}}
    </div>

    <!-- Details -->
    <div class="space-y-6">
        <div>
            {{#with this.product_meta}}
            {{>components/product_details/product_title}}
            {{/with}}
        </div>
        {{!-- Storage --}}
        {{#with this.storage_option}}
        {{>components/product_details/storage}}
        {{/with}}
        <!--Color-->
        {{#if color_options}}
        {{>components/product_details/color}}
        {{/if}}
        <!-- Quantity -->
        <div>
            <h3 class="text-lg font-semibold mb-3">Quantity</h3>
            <div class="inline-flex border-2 border-gray-300 rounded-lg">
                <button onclick="decreaseQuantity()" class="px-4 py-2 hover:bg-gray-100">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                    </svg>
                </button>
                <input id="quantityInput" type="text" value="1" readonly
                    class="w-16 text-center font-semibold text-lg border-x-2 border-gray-300 py-2">
                <button onclick="increaseQuantity()" class="px-4 py-2 hover:bg-gray-100">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4">
                        </path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Buttons -->
        <a href="https://wa.me/254723821511?text=Hi!%20I'm%20interested%20in%20the%20S24%20Ultra%20Smartwatch.%20Can%20you%20tell%20me%20more?"
            class="w-full text-white bg-blue-600 border-2 border-gray-300 py-4 rounded-xl font-bold 
            text-lg hover:border-gray-400 flex items-center justify-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="32px"
                class="cursor-pointer fill-[#25D366] group-hover:fill-blue-700 inline transition-colors duration-200"
                viewBox="0 0 32 32">
                <path
                    d="M16 3C9.373 3 4 8.373 4 15c0 2.65.87 5.1 2.36 7.1L4 29l7.18-2.32C12.97 27.56 14.46 28 16 28c6.627 0 12-5.373 12-12S22.627 3 16 3zm0 22c-1.36 0-2.68-.28-3.91-.81l-.28-.12-4.26 1.38 1.4-4.14-.18-.29C7.29 18.01 7 16.53 7 15c0-5.01 4.06-9.07 9.07-9.07S25.14 9.99 25.14 15 21.08 24.07 16 24.07zm5.07-6.09c-.28-.14-1.65-.81-1.9-.9-.25-.09-.43-.14-.61.14-.18.28-.7.9-.86 1.08-.16.18-.32.2-.6.07-.28-.14-1.18-.43-2.25-1.37-.83-.74-1.39-1.65-1.55-1.93-.16-.28-.02-.43.12-.57.12-.12.28-.32.42-.48.14-.16.18-.28.28-.46.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.45-.46-.61-.47-.16-.01-.34-.01-.52-.01-.18 0-.48.07-.73.34-.25.27-.97.95-.97 2.32s.99 2.69 1.13 2.88c.14.18 1.95 2.98 4.73 4.06.66.23 1.18.37 1.58.47.66.17 1.26.15 1.74.09.53-.08 1.65-.67 1.88-1.32.23-.65.23-1.2.16-1.32-.07-.12-.25-.18-.53-.32z" />
            </svg>
            Order Now
        </a>

        <!-- Features -->
        <div class="bg-blue-50 rounded-xl p-6">
            <h3 class="text-lg font-semibold mb-4">Key Features</h3>
            <ul class="space-y-2">
                {{#each key_features}}
                {{>components/product_details/key_features}}
                {{/each}}
            </ul>
        </div>
    </div>
</div>


<!-- Sticky Navigation Tabs -->
<div class="sticky-nav bg-white shadow-md mt-16 mb-8 rounded-xl">
    <div class="flex justify-center items-center space-x-4 p-4">
        <button class="nav-tab active px-8 py-3 rounded-full border-2 border-gray-300 font-semibold"
            onclick="scrollToSection('product-overview')">
            Product Overview
        </button>
        <button class="nav-tab px-8 py-3 rounded-full border-2 border-gray-300 font-semibold"
            onclick="scrollToSection('product-reviews')">
            Ratings & Reviews
        </button>
    </div>
</div>

<!-- Accordion -->
<div id="product-overview" class="mt-16 bg-white rounded-2xl shadow-lg p-8">
    <h2 class="text-2xl font-bold mb-6">Product Information</h2>

    {{>components/product_details/product_description}}

    {{>components/product_details/return_policy}}
</div>

<!-- Reviews -->
<div id="product-reviews" class="mt-16 bg-white rounded-2xl shadow-lg p-8">
    <h2 class="text-2xl font-bold mb-6">Customer Reviews</h2>

    {{>components/product_details/review_title}}

    <div class="space-y-6">
        {{#each reviews_body}}
        {{>components/product_details/review_body}}
        {{/each}}

    </div>
    <button class="mt-6 text-blue-600 font-semibold hover:text-blue-700">Read all reviews</button>
</div>
<!-- Thumbnail Images -->
<div class="space-y-4">
    {{#with product_meta}}
    {{>components/product_details/main_image}}
    {{/with}}
    <div class="grid grid-cols-4 gap-4">
        {{#each thumbnail_images}}
        <div class="{{active_status}} bg-white rounded-lg cursor-pointer border-2 border-grey-600 {{border_line}} {{hover_effect}}"
            onclick="{{onclick}}">
            <img src="{{image_url}}" alt="Thumb 1" class="w-full rounded">
        </div>
        {{/each}}
    </div>
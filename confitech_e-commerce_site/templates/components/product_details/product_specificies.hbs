<h3 class="text-lg font-semibold mb-3">{{product_details.storage.storage_option.title}}</h3>
<div class="flex gap-3">
    {{#each product_details.storage.storage_option.options}}
    <button
        class="size-button {{selected_status}} px-6 py-3 border-2 border-gray-300 rounded-lg font-semibold hover:border-blue-600"
        onclick="selectSize(this)">
        {{storage}}
    </button>
    {{/each}}
</div>

<div>
    <h3 class="text-lg font-semibold mb-3">Color</h3>
    <div class="flex gap-3">
        {{#each product_details.storage.color_options}}
        <button class="w-12 h-12 rounded-full border-4 {{border_color}} {{bg_color}}" title="Black"></button>
        {{/each}}
    </div>
</div>
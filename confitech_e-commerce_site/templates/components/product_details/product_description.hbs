<div class="border-b">
    <button class="w-full py-4 flex justify-between items-center" onclick="toggleAccordion(0)">
        <span class="text-lg font-semibold">About {{product_info.title}}</span>
        <svg class="accordion-icon w-6 h-6 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
    </button>
    <div class="accordion-content">
        <div class="pb-4">
            <p class="text-gray-600 mb-4">{{product_info.description}}</p>
            
            <!-- Specifications -->
            <h3 class="text-2xl font-bold text-gray-800 mb-6">SPECIFICATIONS</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {{#each product_info.specification}}
                <div class="{{background}} p-4 rounded-lg">
                    <p class="text-sm font-semibold text-gray-600 mb-1">
                        {{sub_title}}</p>
                    <p class="text-gray-900">{{description}}</p>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
<div class="border-b pb-6">
    <div class="flex gap-4">
        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
            <span class="font-bold {{initials_color}}">{{reviewer_initials}}</span>
        </div>
        <div class="flex-1">
            <div class="flex justify-between mb-2">
                <div>
                    <h4 class="font-semibold">{{reviewer_name}}</h4>
                    <p class="text-sm text-gray-600">{{review_date}}</p>
                </div>
                <div class="text-blue-600">{{review_rating}}<span class="text-gray-300">★</span></div>
            </div>
            <p class="text-gray-700">{{review_text}}</p>
        </div>
    </div>
</div>
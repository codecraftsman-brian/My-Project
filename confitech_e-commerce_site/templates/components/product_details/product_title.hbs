<h1 class="text-4xl font-bold text-gray-900 mb-3">{{title}}</h1>
<p class="text-lg text-gray-600 mb-4">{{description}}</p>
<div class="flex items-center space-x-3 mb-4">
    <span class="bg-green-600 text-white px-3 py-1 rounded-full text-sm font-bold">{{rating}} ⭐</span>
    <span class="text-gray-600">{{rating_count}} ratings and {{review_count}} reviews</span>
</div>
<div class="flex items-baseline space-x-4 mb-6">
    <span class="text-4xl font-bold">Ksh{{price}}</span>
    {{#if prev_price}}
    <span class="text-2xl text-gray-400 line-through">ksh{{prev_price}}</span>
    {{/if}}
    {{#if discount}}
    <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-semibold">Save
        {{discount}}</span>
    {{/if}}
</div>
<p class="text-sm text-gray-600 mb-6">Tax included • Free shipping over $50</p>
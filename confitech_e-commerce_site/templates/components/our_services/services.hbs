<div class="max-w-7xl mx-auto bg-gradient-to-r from-blue-50 to-purple-50 rounded-3xl p-8 md:p-12 mb-16">
    <h2 class="text-4xl font-bold text-gray-900 mb-12 text-center">Our Services</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {{#each our_services.services}}
        <div class="text-center group">
            <div
                class="service-circle w-48 h-48 mx-auto  {{bg_color}} rounded-full shadow-lg flex items-center justify-center mb-4 text-white">
                <span class="text-xl font-bold">{{first_word}}<br>{{second_word}}</span>
            </div>
        </div>
        {{/each}}
    </div>
</div>

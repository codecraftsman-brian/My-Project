<div class="max-w-7xl mx-auto bg-white rounded-3xl shadow-lg p-8 md:p-12">
    <h2 class="text-4xl font-bold text-gray-900 mb-12">Why Choose Us?</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Why Us Section -->
        {{#each our_services.why_us}}
        <div class="flex items-start space-x-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0">
                <img src="{{icon}}" alt="Countrywide Delivery">
            </div>
            <div>
                <h3 class="font-bold text-lg mb-2">{{reason_title}}</h3>
                <p class="text-gray-600 text-sm">{{reason_descr}}</p>
            </div>
        </div>
        {{/each}}
    </div>
</div>
<a id="{{id}}" class="absolute inset-0 h-full w-full tv-carousel-slide bg-cover bg-center"
    style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('{{image_url}}');"
    href="{{page_link}}">
    <div class="relative h-full flex items-center justify-center px-8">
        <div class="text-white text-center lg:text-left max-w-2xl">
            <h1 class="text-3xl sm:text-4xl lg:text-6xl font-bold mb-6 leading-tight">
                {{{title}}}
            </h1>
            <p class="text-lg sm:text-xl lg:text-2xl mb-8 opacity-90">
               {{description}}
            </p>
            <button
                class="bg-yellow-400 hover:bg-yellow-300 text-gray-900 px-8 py-4 rounded-full font-bold text-lg transition-all transform hover:scale-105 shadow-lg hover:shadow-xl">
                {{button_name}}
            </button>
        </div>
    </div>
</a>
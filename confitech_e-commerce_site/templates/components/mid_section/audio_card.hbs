<div class="bg-cover bg-center rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2 relative overflow-hidden cursor-pointer group h-48 lg:h-44"
    style="background-image: linear-gradient(135deg, rgba(59, 131, 246, 0.1), rgba(147, 51, 234, 0.1)), url('{{image_url}}');">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-600/80 to-purple-700/80"></div>
    <div class="relative h-full flex flex-col justify-between p-6">
        <div class="flex items-start justify-between">
            <div class="bg-white/20 backdrop-blur-sm rounded-full p-3 group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15.536a5 5 0 001.414 1.414">
                    </path>
                </svg>
            </div>
        </div>
        <div class="text-white">
            <h3 class="font-bold text-xl lg:text-2xl mb-2">{{title}}</h3>
            <p class="text-white/90 text-sm mb-3">{{description}}</p>
            <div class="flex items-center justify-between">
                <span class="text-white font-bold text-lg">From {{price}}</span>
                <div class="flex items-center text-sm">
                    <span class="mr-2">Shop Now</span>
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                        </path>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>
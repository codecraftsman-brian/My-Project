<div class="flex border-b border-gray-300 bg-white min-h-[70px] tracking-wide relative z-50">
    <div class="px-3 py-3 w-full">
        <div class="flex justify-between items-center sm:px-10  gap-2 w-full max-w-screen-xl mx-auto">
            <div id="collapseMenu" class="max-lg:hidden">
                <ul
                    class="lg:flex lg:gap-x-9 max-lg:space-y-3 max-lg:fixed max-lg:bg-white max-lg:w-1/2 max-lg:min-w-[300px] max-lg:top-0 max-lg:left-0 max-lg:p-6 max-lg:h-full max-lg:shadow-md max-lg:overflow-auto z-50">
                    {{#each menu_bar.list}}
                    {{#if (eq type "dropdown")}}
                    {{>components/navbar/menu_bar_nav/dropdown/dropdown_list label=text}}
                    {{else}}
                    <li class="max-lg:border-b max-lg:border-gray-300 max-lg:py-3">
                        <a href='{{page_link}}' class="{{@root.menu_bar.anchor_styles}}">{{text}}</a>
                    </li>
                    {{/if}}
                    {{/each}}
                </ul>
            </div>

            <div class="flex items-center max-lg:ml-auto">
                <a href="https://wa.me/{{menu_bar.contact_no}}" target="_blank" rel="noopener" class="relative group">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32px"
                        class="cursor-pointer fill-[#25D366] group-hover:fill-blue-700 inline transition-colors duration-200"
                        viewBox="0 0 32 32">
                        <path
                            d="M16 3C9.373 3 4 8.373 4 15c0 2.65.87 5.1 2.36 7.1L4 29l7.18-2.32C12.97 27.56 14.46 28 16 28c6.627 0 12-5.373 12-12S22.627 3 16 3zm0 22c-1.36 0-2.68-.28-3.91-.81l-.28-.12-4.26 1.38 1.4-4.14-.18-.29C7.29 18.01 7 16.53 7 15c0-5.01 4.06-9.07 9.07-9.07S25.14 9.99 25.14 15 21.08 24.07 16 24.07zm5.07-6.09c-.28-.14-1.65-.81-1.9-.9-.25-.09-.43-.14-.61.14-.18.28-.7.9-.86 1.08-.16.18-.32.2-.6.07-.28-.14-1.18-.43-2.25-1.37-.83-.74-1.39-1.65-1.55-1.93-.16-.28-.02-.43.12-.57.12-.12.28-.32.42-.48.14-.16.18-.28.28-.46.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.45-.46-.61-.47-.16-.01-.34-.01-.52-.01-.18 0-.48.07-.73.34-.25.27-.97.95-.97 2.32s.99 2.69 1.13 2.88c.14.18 1.95 2.98 4.73 4.06.66.23 1.18.37 1.58.47.66.17 1.26.15 1.74.09.53-.08 1.65-.67 1.88-1.32.23-.65.23-1.2.16-1.32-.07-.12-.25-.18-.53-.32z" />
                    </svg>
                </a>
                <div class="flex flex-col text-sm mr-2">
                    <div>
                        <p class="font-bold">WhatsApp</p>
                    </div>
                    <div>
                        <p>Chat to order</p>
                    </div>
                </div>
                <button id="toggleOpen" class="lg:hidden cursor-pointer">
                    <svg class="w-7 h-7" fill="#000" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd"
                            d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                            clip-rule="evenodd"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>
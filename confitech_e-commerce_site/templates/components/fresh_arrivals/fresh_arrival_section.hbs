<div
    class="flex-shrink-0 w-72 bg-white rounded-2xl shadow-md hover:shadow-xl transition-all hover:scale-105 transform p-6 group">
    <div class="relative mb-4">
        <div class="w-full h-48 bg-gradient-to-br from-gray-100 to-gray-200 rounded-xl flex items-center justify-center relative overflow-hidden bg-center bg-cover"
            style="background-image: url('{{image_url}}');">
        </div>
        <div class="absolute top-2 left-2 {{tag_bg_color}} text-white px-2 py-1 rounded-full text-xs font-bold">
            {{tag_name}}</div>
        <div class="absolute top-2 right-2 flex text-yellow-400 text-sm">{{ratings}}</div>
    </div>
    <div>
        <h3 class="font-bold text-lg text-gray-900 mb-1">{{title}}</h3>
        <p class="text-gray-600 text-sm mb-3">{{description}}</p>
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center space-x-2">
                <span class="text-xl font-bold {{price_color}}">{{price}}</span>
            </div>
            <span class="{{stock_indicator_color}} text-sm font-medium">{{stock_indicator}}</span>
        </div>
        <button class="w-full {{button_bg_color}} text-white py-2 rounded-lg hover:bg-blue-700 transition-colors font-semibold">
            Quick Add
        </button>
    </div>
</div>
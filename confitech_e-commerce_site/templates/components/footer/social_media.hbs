<div>
    <h4 class="text-lg font-bold">Follow Us</h4>

    <div class="flex space-x-1 mb-4">
        {{#each footer.footer_info.social_media}}
        <a href="{{link}}"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-purple-500">
            {{> (lookup this 'icon') }}
        </a>
        {{/each}}
    </div>
    <div class="space-y-1">
        <p class="text-sm"><span class="text-lg font-bold">Shop Location:</span></p>
        <p class="text-gray-400 text-sm"><strong>Midtown Business Center</strong>, Taveta Road
            Opposite London Beauty Building
            2nd Floor, <strong>Shop S-70</strong> </p>
    </div>
    <div>
        <p class="text-sm"><span class="text-lg font-bold">Email:</span></p>
        {{#with footer.footer_info.email}}
        <p class="text-gray-400 text-sm">{{email_address}}</p>
        {{/with}}
    </div>
</div>
<h4 class="text-lg font-bold">Contact Us</h4>
<ul class="space-y-1">
    {{#each footer.footer_info.contact_payment.contact}}
    <li class="flex items-start">
        <span class="font-bold text-gray-400 mr-2 min-w-[80px]">{{title}}:</span>
        <a href="{{contact_link}}"
            class="text-white hover:text-white transition-colors text-sm">{{contact_details}}</a>
    </li>
    {{/each}}
</ul>

<!-- Payment Methods -->
<div class="mt-6">
    <p class="text-sm font-semibold mb-3">We Accept:</p>
    <div class="flex flex-wrap gap-2">
        {{#each footer.footer_info.contact_payment.payment}}
        <div class="bg-white rounded px-3 py-1">
            <span class="text-gray-900 text-xs font-bold">{{title}}</span>
        </div>
        {{/each}}
    </div>
</div>
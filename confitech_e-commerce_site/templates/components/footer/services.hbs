<div>
    <h4 class="text-lg font-bold">Services</h4>
    <ul class="">
        {{#each footer.footer_info.our_services.services}}
        <li><a href="{{page_link}}" class="text-gray-400 hover:text-white transition-colors text-sm">{{title}}</a></li>
        {{/each}}
    </ul>

    {{#with footer.footer_info.our_services}}
    <h4 class="text-lg font-bold mt-4">{{title}}</h4>
    <p class="text-gray-400 text-sm">{{weekday}}</p>
    <p class="text-white text-sm font-semibold">{{weekday_time}}</p>
    <p class="text-gray-400 text-sm">{{weekend}}</p>
    <p class="text-white text-sm font-semibold">{{weekend_time}}</p>
    {{/with}}

</div>
<div id="{{id}}" class="absolute inset-0 h-full w-full slide-in slide-bg bg-cover bg-center"
    style="background-image: url('{{image_url}}');">
    <div class="relative h-full flex items-center justify-between px-8">
        <div class="text-white z-10">
            <h1 class="text-4xl lg:text-6xl font-bold my-10 leading-tight">
                {{{title}}}
            </h1>
            <p class="text-xl lg:text-2xl mb-8">
                {{description}}
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
                <a href="{{page_link}}"
                    class="bg-white text-gray-900 px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition-all transform hover:scale-105">
                    Shop Now
                </a>
            </div>
        </div>
        <div class="hidden lg:block">
            <div
                class="w-64 h-64 bg-white/20 rounded-full flex items-center justify-center backdrop-blur-sm overflow-hidden shadow-lg">
                <img src="/static/images/iPhone.jpg" alt="" class="w-full h-full object-cover" />
            </div>
        </div>
    </div>
</div>
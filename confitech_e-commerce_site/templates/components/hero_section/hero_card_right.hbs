<a href="{{page_link}}"
    class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1 p-4 flex-1 group">
    <div class="flex items-center space-x-4">
        <div
            class="w-16 h-16 bg-gradient-to-br {{icon_bg_color}} rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
            {{> (lookup this 'icon') }}
        </div>
        <div>
            <h3 class="font-semibold text-gray-900 text-lg">{{title}}</h3>
            <p class="text-gray-600 text-sm">{{description}}</p>
            <span class="{{price_color}} text-sm font-medium">{{price}}</span>
        </div>
    </div>
</a>
<div class="max-w-7xl mx-auto mt-4 px-4 sm:px-6 lg:px-8">
    <nav class="flex text-sm text-gray-600 gap-2">
        {{#each breadcrumbs}}

        {{#if link}}
        <a href="{{link}}" class="hover:text-blue-600">{{name}}</a>
        <span class="mx-2">/</span>
        {{else}}
        <span class="text-gray-900 font-semibold">{{name}}</span>
        {{/if}}

        {{/each}}
    </nav>
</div>